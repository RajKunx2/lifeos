# ── Nothing here is required to run `npm run dev` and see the dashboard. ──
# The dashboard reads from lib/sample-data.ts (static, no DB). Everything
# below is only needed if you wire up the real Gmail -> LLM -> Mongo
# pipeline in lib/ and app/api/gmail/. See HOW_IT_WORKS.md.

# MongoDB — where parsed transactions land.
MONGODB_URI=mongodb://localhost:27017/expense-tracker-showcase

# Google OAuth — a Gmail account with the gmail.readonly scope.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/api/gmail/oauth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Google Cloud Pub/Sub — the topic Gmail publishes new-message
# notifications to, and the push subscription that calls your webhook.
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT_ID/topics/gmail-inbox
# A shared secret appended to the webhook URL as ?token=..., so random
# internet traffic can't trigger a sync. Generate with `openssl rand -hex 32`.
GMAIL_WEBHOOK_SECRET=

# The two bank senders this sample matches on. Comma-separated; each is
# used as a Gmail `from:(...)` search fragment (address or display name).
BANK_SENDER_PATTERNS=Meridian Bank,Northfield Bank

# LLM — any OpenAI-compatible chat-completions endpoint works. The
# reference client targets Azure OpenAI; swap the fetch URL in lib/llm.ts
# for plain OpenAI, Anthropic, or a local model if you'd rather.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional spend guardrail — stop extracting once this much has been
# spent on LLM calls this calendar month.
LLM_MONTHLY_CAP_INR=500
